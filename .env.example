# Copy this file to .env and fill in your own project's values.
# Project Settings > API Keys in the Supabase dashboard.
# EXPO_PUBLIC_ prefix is required for Expo to expose these to app code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
