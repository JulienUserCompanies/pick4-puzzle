{
  "expo": {
    "name": "Pick 4",
    "slug": "pick4-puzzle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FDECDA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pick4puzzle.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Pick 4 uses motion to add a subtle tilt effect on the win screen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDECDA"
      },
      "package": "com.pick4puzzle.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-audio"
    ]
  }
}
